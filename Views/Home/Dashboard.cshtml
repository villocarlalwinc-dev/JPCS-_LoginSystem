@model List<JPCS.Models.Announcement>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Welcome, @ViewBag.FullName!</h2>
        <a asp-controller="Account" asp-action="Logout" class="btn btn-secondary">Logout</a>
    </div>

    <h4>Announcements</h4>
    @foreach (var a in Model)
    {
        <div class="card mb-2 p-3">
            <h5>@a.Title</h5>
            <p>@a.Content</p>
            <small class="text-muted">@a.DatePosted.ToString("MMMM dd, yyyy")</small>
        </div>
    }
</div>
