@model List<JPCS.Models.Announcement>

<div class="container mt-5">
    <div class="d-flex justify-content-center gap-3">
        <a asp-controller="Book" asp-action="Index" class="btn btn-outline-primary btn-lg">Book Catalog</a>
        <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-secondary btn-lg">My Account</a>
        <a href="#" onclick="if(confirm('Are you sure you want to logout?')) { window.location.href='@Url.Action("Logout","Account")'; } return false;" class="btn btn-secondary btn-lg">Logout</a>
    </div>
</div>
