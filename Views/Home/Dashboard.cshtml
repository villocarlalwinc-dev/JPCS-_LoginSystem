@model List<JPCS.Models.Announcement>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Welcome, @ViewBag.FullName!</h2>
        <div>
            <a asp-controller="Book" asp-action="Index" class="btn btn-outline-primary me-2">Book Catalog</a>
            <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-secondary me-2">My Account</a>
            <a href="#" onclick="if(confirm('Are you sure you want to logout?')) { window.location.href='@Url.Action("Logout","Account")'; } return false;" class="btn btn-secondary">Logout</a>
        </div>
    </div>

    <h4>Announcements</h4>
    @foreach (var a in Model)
    {
        <div class="card mb-2 p-3">
            <h5>@a.Title</h5>
            <p>@a.Content</p>
            <small class="text-muted">@a.DatePosted.ToString("MMMM dd, yyyy")</small>
        </div>
    }
</div>
